# Model weights
# These exceed GitHub's 100MB limit and live alongside the code on disk.
# Small model metadata (config.json, tokenizer.json, *_metrics.json) is NOT
# ignored so the repo still documents each model's shape and calibration.
*.safetensors
*.pt
*.pth
*.bin
*.ckpt
# Optimizer/scheduler/RNG state and arrow shards are pure training artifacts.
optimizer.pt
scheduler.pt
rng_state*.pth
*.arrow

# Logs, databases, and caches
*.log
*.sqlite3
*.djcache

