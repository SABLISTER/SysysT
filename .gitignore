# Local configuration can contain API keys and filesystem paths
# These are runtime-generated by the GUI "Save Config" action.
# To get started, copy pipeline_config.example.json → pipeline_config.json
# and fill in your keys, or export the matching environment variables instead.
pipeline_config.json
pipeline_config9.json
